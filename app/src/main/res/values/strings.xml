    <!-- How to (settings page "怎么操作", profile B19): each main action, hands and controller -->
    <string name="how_to_title">How to</string>
    <string name="how_to_hands_line">Hands: %1$s</string>
    <string name="how_to_ctrl_line">Controller: %1$s</string>
    <string name="how_to_press">Press a button</string>
    <string name="how_to_press_hands">look at it and pinch.</string>
    <string name="how_to_press_ctrl">point the ray at it, pull the trigger.</string>
    <string name="how_to_move">Move or close this panel</string>
    <string name="how_to_move_hands">look at the dot under the panel, pinch its middle knob and move; × closes it.</string>
    <string name="how_to_move_ctrl">point at the dot under the panel, hold the trigger on its middle knob and move.</string>
    <string name="how_to_call">Stop the scan (call ball)</string>
    <string name="how_to_call_hands">pinch and hold for half a second on the room.</string>
    <string name="how_to_call_ctrl">hold the trigger for half a second, anywhere.</string>
    <string name="how_to_still">Keep still in the scanner</string>
    <string name="how_to_still_hands">lie back, rest your head; the ring stays white.</string>
    <string name="how_to_still_ctrl">same; amber = small movement, red = big.</string>
    <string name="how_to_tour">Learn the room (tour)</string>
    <string name="how_to_tour_hands">look at a lit object and pinch to jump to it.</string>
    <string name="how_to_tour_ctrl">point at it and pull the trigger.</string>
    <string name="how_to_recall">Lost the panel?</string>
    <string name="how_to_recall_hands">pinch Open panel in front of you, or Settings ▸ Bring back in front.</string>
    <string name="how_to_recall_ctrl">point at Open panel and pull the trigger.</string>
</resources>
